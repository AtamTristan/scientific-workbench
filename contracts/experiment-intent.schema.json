{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientific.local/contracts/experiment-intent/1.0",
  "title": "ExperimentIntent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "projectId", "researchActionId", "protocolId", "hypothesisIds", "objective", "constraints", "repositoryRef", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "$ref": "#/$defs/id" },
    "projectId": { "$ref": "#/$defs/id" },
    "researchActionId": { "$ref": "#/$defs/id" },
    "protocolId": { "$ref": "#/$defs/id" },
    "hypothesisIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "objective": { "type": "string", "minLength": 1 },
    "constraints": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": ["string", "number", "boolean"] }
      }
    },
    "repositoryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": { "id": { "type": "string", "minLength": 1 } }
}
